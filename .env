# ==========================================================
# AGENT 47 PLATFORM - ENVIRONMENT CONFIGURATION
# ==========================================================

# Port Configuration
# If port 80 is busy on your VPS, change HOST_PORT to 8080, 8000, etc.
HOST_PORT=8080
PORT=8000
ENVIRONMENT=production

# Admin Security PIN (Default: 1234)
ADMIN_PIN=1234

# Gemini AI Bot API Keys (Optional - can also be configured inside Admin Studio)
GEMINI_API_KEY_BOT1=
GEMINI_API_KEY_BOT2=
GEMINI_API_KEY_BOT3=
